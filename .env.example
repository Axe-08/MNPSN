# L1 Anchor Configuration
SEPOLIA_RPC_URL="https://rpc.sepolia.org" # Replace with your Alchemy/Infura RPC URL
DEPLOYER_PRIVATE_KEY="" # Your wallet private key with Sepolia ETH (must start with 0x)
